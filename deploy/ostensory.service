[Unit]
Description=Ostensory image host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ostensory
Group=ostensory
WorkingDirectory=/opt/ostensory
EnvironmentFile=/etc/ostensory.env
ExecStart=/opt/ostensory/.venv/bin/python run.py
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ostensory/data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target