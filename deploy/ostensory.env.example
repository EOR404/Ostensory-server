# 复制为 /etc/ostensory.env，权限设为 600，放在 systemd 服务可读的位置。
OSTENSORY_HOST=127.0.0.1
OSTENSORY_PORT=8000
OSTENSORY_DATA_DIR=/opt/ostensory/data
OSTENSORY_SECURE_COOKIES=auto
OSTENSORY_SESSION_DAYS=7
OSTENSORY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 可选：合法取得的离线国家数据库
# OSTENSORY_GEOIP_DB=/opt/ostensory/data/geoip/Country.mmdb
# 可选：不落盘保存主密钥（必须正好 64 个十六进制字符）
# OSTENSORY_MASTER_KEY=
# 可选：迁移前完整备份和恢复标记的位置（默认数据目录的上级）
# OSTENSORY_MIGRATION_STATE_DIR=/opt/ostensory/migration-backups
# 可选：迁移包上传/解压大小上限（MB）。留空或 0 表示按磁盘容量、不设应用层上限。
# OSTENSORY_MIGRATION_MAX_MB=0
# OSTENSORY_MIGRATION_MAX_EXTRACTED_MB=0
# 可选：迁移包内文件数量/清单大小上限；留空或 0 表示不设应用层上限。
# OSTENSORY_MIGRATION_MAX_FILES=0
# OSTENSORY_MIGRATION_MAX_MANIFEST_MB=0
# 可选：更新检查仓库、私有仓库 Token、安装后重启命令（CLI `update --restart` 使用）
# OSTENSORY_UPDATE_REPO=EOR404/Ostensory-server
# OSTENSORY_UPDATE_TOKEN=
# OSTENSORY_UPDATE_RESTART_CMD=sudo systemctl restart ostensory
# 依赖由外部管理时跳过自动 pip
# OSTENSORY_UPDATE_SKIP_PIP=1
# Docker 内默认拒绝自更新；确实需要时可显式允许（不推荐）
# OSTENSORY_UPDATE_ALLOW_DOCKER=1