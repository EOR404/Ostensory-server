# 复制为 /etc/ostensory.env，权限设为 600，放在 systemd 服务可读的位置。
OSTENSORY_HOST=127.0.0.1
OSTENSORY_PORT=8000
OSTENSORY_DATA_DIR=/opt/ostensory/data
OSTENSORY_SECURE_COOKIES=auto
OSTENSORY_SESSION_DAYS=7
OSTENSORY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 可选：合法取得的离线国家数据库
# OSTENSORY_GEOIP_DB=/opt/ostensory/data/geoip/Country.mmdb
# 可选：不落盘保存主密钥（必须正好 64 个十六进制字符）
# OSTENSORY_MASTER_KEY=